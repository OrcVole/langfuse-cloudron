# --- Cloudron/agent working files (never publish) ---
.claude/
scratchpad/
*.local
*.local.md
docs/*.local.md

# --- Per-phase handoff / working notes (local-only, never published) ---
phase-notes/
# Glob, not a fixed filename: these name the box and its hostnames, and a second
# foundation doc (langfuse-clickhouse-resource-foundation.md) landed here untracked
# but UNignored, one `git add .` from publishing host specifics.
*foundation*.md

# --- Local-only reference docs (cross-package maintainer playbook) ---
cloudron-packaging-field-guide-*.md

# --- Logo source (logo.png is the tracked, canonical copy) ---
langfuse-logo-512.png

# --- Secrets / tokens (defensive; real tokens live outside the repo) ---
*token*.txt
*.secret
*.secrets
.env
.env.*
!.env.example

# --- Build / OS cruft ---
node_modules/
*.log
.DS_Store
Thumbs.db
*.tmp

# The anonymity denylist names what must never be published, so it is never published itself.
.anonymize-list
