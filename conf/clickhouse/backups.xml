<?xml version="1.0"?>
<!-- Lets `clickhouse local` write/read File backups under /app/data (the Cloudron-backed-up dir). Used
     ONLY by backup-clickhouse.sh in the temporary backup container, where the server config is not in
     play. The same allowed_path is set for the real server in config.d/cloudron.xml.

     HISTORY, because this file has now flipped once per ClickHouse major and will be suspected first
     next time. Langfuse's migrations create the `default` database explicitly, so the store carries
     metadata/default.sql. On ClickHouse 25.3, `clickhouse local` also created its own implicit
     `default` eagerly, loading the snapshot then failed with Code 82 DATABASE_ALREADY_EXISTS, and the
     fix was a `default_database` override renaming the implicit database out of the way (field guide
     gotcha 108). On 26.4 that override is itself the failure: with it set, loading the store dies with
     Code 57 TABLE_ALREADY_EXISTS, a table-UUID mapping collision while loading `default` from
     metadata/default.sql; without it, 26.4 loads the explicit `default` cleanly and BACKUP succeeds.
     Reproduced both ways on a minimal one-table store against this image's exact binary, 2026-08-02.
     If a future ClickHouse bump breaks this file again, test BOTH configurations on a store carrying
     metadata/default.sql before reaching for anything cleverer.

     NOTE: a double hyphen is illegal inside an XML comment and makes ClickHouse fail to start with a
     SAXParseException, so keep prose here free of them. -->
<clickhouse>
    <backups>
        <allowed_path>/app/data</allowed_path>
    </backups>
</clickhouse>
