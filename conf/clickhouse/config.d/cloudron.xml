<?xml version="1.0"?>
<!-- Cloudron overrides merged over ClickHouse's default config.xml (config.d/*.xml is auto-loaded).

     v0.2.0 (ADR 0006): the ClickHouse store MOVED OUT of /app/data to the /var/lib/clickhouse
     persistentDir. persistentDirs are excluded from Cloudron's filesystem backup walk, so ClickHouse's
     constant tmp_merge_*/tmp_insert_* churn can no longer make the syncer trip and abort the whole
     server's backup run. The data stays inside the backup surface via backupCommand/restoreCommand,
     which dump it logically into /app/data. Existing installs are migrated once, on boot (ADR 0008).

     Logs move with it: they are not backup-critical, and moving them out of the walk is a bonus.
     Bind localhost only. -->
<clickhouse>
    <path>/var/lib/clickhouse/</path>
    <tmp_path>/var/lib/clickhouse/tmp/</tmp_path>
    <user_files_path>/var/lib/clickhouse/user_files/</user_files_path>
    <format_schema_path>/var/lib/clickhouse/format_schemas/</format_schema_path>
    <user_directories>
        <users_xml><path>users.xml</path></users_xml>
        <local_directory><path>/var/lib/clickhouse/access/</path></local_directory>
    </user_directories>

    <!-- Sandbox File backups to /app/data so the transient server used by restore-clickhouse.sh can read
         the dump Cloudron restored there. The standalone conf/clickhouse/backups.xml carries the same
         setting for the `clickhouse local` invocation in backup-clickhouse.sh. -->
    <backups>
        <allowed_path>/app/data</allowed_path>
    </backups>

    <!-- Default file logs go to read-only /var/log; redirect into the persistentDir and also echo to
         stdout (Cloudron captures stdout/stderr). -->
    <logger>
        <console>1</console>
        <level>warning</level>
        <log>/var/lib/clickhouse/logs/clickhouse-server.log</log>
        <errorlog>/var/lib/clickhouse/logs/clickhouse-server.err.log</errorlog>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- localhost only: Langfuse connects via localhost; the docker_related_config.xml that forces
         0.0.0.0/:: is removed at build time (Dockerfile). listen_try avoids a hard fail if v6 is off. -->
    <listen_host>127.0.0.1</listen_host>
    <listen_host>::1</listen_host>
    <listen_try>1</listen_try>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <!-- single-node embedded ClickHouse: drop surfaces Langfuse never uses -->
    <interserver_http_port remove="1"/>
    <mysql_port remove="1"/>
    <postgresql_port remove="1"/>

    <!-- Langfuse returns empty/wrong results on a non-UTC ClickHouse (field-guide gotcha 32). -->
    <timezone>UTC</timezone>

    <!-- Absolute cap, NOT a ratio: it is unverified whether the bundled CH reads the cgroup limit or host
         RAM; a ratio against misread host RAM could OOM-kill the container (AGENTS.md, ADR memory note).
         v0.3.0: raised 2 GiB to 2.5 GiB with ClickHouse 26.4, whose memory accounting is RSS-based and
         whose baseline footprint is larger than 25.3's: on a 32-core host the old cap was breached at
         near-idle (RSS 2.16 GiB) and EVERY query then failed MEMORY_LIMIT_EXCEEDED, caught by
         test/ingest.sh. The app's total memoryLimit moved 5 to 6 GiB in the same change. -->
    <max_server_memory_usage>2684354560</max_server_memory_usage>
    <mark_cache_size>536870912</mark_cache_size>

    <!-- v0.2.1 (ADR 0011): bound ClickHouse's own telemetry tables. Left on defaults they grow without
         limit and dominate the store: a five-week idle production install held 19.7 kB of application
         data against 176 million system-log rows in 3.9 GB, whose parts metadata alone pinned tracked
         memory above the cap (every aggregating query then fails) and whose background merges burned
         4.5 to 7.8 cores continuously. Element set verified against THIS image's ClickHouse 26.4 via
         its shipped config.xml + system.tables on a live 26.4 container (2026-08-02), because the set
         differs across versions and a wrong element name fails silently. Differences from the 25.3 set
         this file previously carried: latency_log no longer exists in 26.4 (element dropped here);
         histogram_metric_log and background_schedule_pool_log are new in 26.4 and disabled below
         (histogram_metric_log was observed actively writing at idle on a stock 26.4 container).
         query_log and error_log are kept, TTL-bounded, because they are the two an operator actually
         reads when debugging. NOTE for updates of existing installs: adding a TTL makes ClickHouse
         rename the old table to <name>_0 and start fresh; the one-time DROP of removed tables and the
         _0 renames is a deliberate operator step (docs/KNOWN-ISSUES.md), done together with the deploy,
         never deferred. Prior art: the sibling Laminar package, its ADR 0012. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <part_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <histogram_metric_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <!-- The rest of 26.4's active-by-default log elements, disabled on the same principle. Three are
         hot on THIS deployment: query_views_log writes a row per materialised-view execution and v4's
         events_core is MV-populated (fires on every ingest); query_thread_log multiplies query_log
         by thread count; blob_storage_log writes per blob operation. The remainder are inert here
         (no ZooKeeper, no Iceberg/Delta lakehouse; backup_log never fires on the live server because
         backupCommand dumps via clickhouse local on a snapshot copy) but cost nothing to disable and
         would otherwise be a surprise the first time a feature touches them. session_log and
         zookeeper_log are commented out in stock 26.4 config and need no element here. crash_log is
         KEPT deliberately: it writes only on a server crash, and it is precisely what an operator
         reads after one (the same test that keeps query_log and error_log). -->
    <query_views_log remove="1"/>
    <query_thread_log remove="1"/>
    <blob_storage_log remove="1"/>
    <instrumentation_trace_log remove="1"/>
    <backup_log remove="1"/>
    <aggregated_zookeeper_log remove="1"/>
    <zookeeper_connection_log remove="1"/>
    <delta_lake_metadata_log remove="1"/>
    <iceberg_metadata_log remove="1"/>
    <query_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></query_log>
    <error_log><ttl>event_date + INTERVAL 3 DAY DELETE</ttl></error_log>
</clickhouse>
